# Copy to expops.env in the directory where you invoke expops.
# Existing shell values override this file. No shell commands are executed.
# Credentials stay local; provision credential files/roles separately on workers.

# Required by the PostgreSQL metadata profile:
# CREDIT_CARD_FRAUD_SQL_PASSWORD=replace-locally

# NUS deployment settings (Linux only):
# MLOPS_WORKER_PYTHON=${HOME}/fyp-expops/expops-platform/.venv/bin/python
# MLOPS_WORKER_BASE_DIR=/var/tmp/${USER}-expops-credit-card-fraud

# Optional application variables to send to workers explicitly:
# EXPOPS_WORKER_ENV=MY_APPLICATION_SETTING
# MY_APPLICATION_SETTING=example
