# Copy to /home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/expops.env.
# Primary Git/S3/GCS/SQLite profile: no database password is required.
TMPDIR=/home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/tmp
TMP=/home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/tmp
TEMP=/home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/tmp
PIP_CACHE_DIR=/home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/pip-cache
XDG_CACHE_HOME=/home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/cache
DASK_TEMPORARY_DIRECTORY=/home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/dask
JOBLIB_TEMP_FOLDER=/home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/joblib
MLOPS_WORKSPACE_BASE_DIR=/home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/workspaces
MLOPS_DATA_MATERIALIZATION_DIR=/home/e/e1115319/fyp-expops/git-s3-gcs-sqlite/materializations
DASK_DISTRIBUTED__COMM__COMPRESSION=zlib
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
EXPOPS_WORKER_ENV=OPENBLAS_NUM_THREADS,OMP_NUM_THREADS
