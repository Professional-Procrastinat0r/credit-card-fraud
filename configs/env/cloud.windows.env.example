# Copy to D:/NUS/FYP/credit-card-fraud/expops.env. PostgreSQL needs the password below.
TMPDIR=D:/NUS/FYP/credit-card-fraud/.credit-card-fraud/tmp
TMP=D:/NUS/FYP/credit-card-fraud/.credit-card-fraud/tmp
TEMP=D:/NUS/FYP/credit-card-fraud/.credit-card-fraud/tmp
PIP_CACHE_DIR=D:/NUS/FYP/credit-card-fraud/.credit-card-fraud/pip-cache
XDG_CACHE_HOME=D:/NUS/FYP/credit-card-fraud/.credit-card-fraud/cache
DASK_TEMPORARY_DIRECTORY=D:/NUS/FYP/credit-card-fraud/.credit-card-fraud/dask
JOBLIB_TEMP_FOLDER=D:/NUS/FYP/credit-card-fraud/.credit-card-fraud/joblib
MLOPS_WORKSPACE_BASE_DIR=D:/NUS/FYP/credit-card-fraud/.credit-card-fraud/workspaces
MLOPS_DATA_MATERIALIZATION_DIR=D:/NUS/FYP/credit-card-fraud/.credit-card-fraud/materializations
DASK_DISTRIBUTED__COMM__COMPRESSION=zlib
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MLOPS_WORKER_ENV=OPENBLAS_NUM_THREADS,OMP_NUM_THREADS

# For configs/compute.cloud.yaml only: fill the password and provision AWS profile expops.
CREDIT_CARD_FRAUD_SQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/User/AppData/Roaming/gcloud/application_default_credentials.json
AWS_PROFILE=expops
# AWS uses its normal SDK credential chain. Configure profile expops once,
# or set AWS_SHARED_CREDENTIALS_FILE / AWS_CONFIG_FILE to existing local files.
