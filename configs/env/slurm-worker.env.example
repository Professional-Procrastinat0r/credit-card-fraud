# Select this additional dotenv on the driver; workers receive values and credential bytes.
# NUS destination: /home/e/e1115319/.config/expops/expops.env
# Driver credential files stay outside the project and Git; ExpOps delivers private worker copies.
GOOGLE_APPLICATION_CREDENTIALS=/home/e/e1115319/.config/expops/gcp-adc.json
AWS_PROFILE=expops
AWS_SHARED_CREDENTIALS_FILE=/home/e/e1115319/.config/expops/aws-expops-credentials
AWS_CONFIG_FILE=/home/e/e1115319/.config/expops/aws-expops-config
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
